{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DiscReveal",
  "version": "0.3.15",
  "identifier": "de.markmarkinson.discreveal",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "windows": [
      {
        "title": "DiscReveal",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "markMarkinson",
    "copyright": "Copyright (c) markMarkinson, DiscReveal Source-Available License 1.0",
    "category": "Utility",
    "shortDescription": "Fast disk space analyzer"
  }
}
